{
  "name": "mdi2esm",
  "version": "0.2.0",
  "description": "A markdown-it wrapper with common plugins integrated: containers, footnotes, task lists, anchors, code highlighting, KaTeX math, Mermaid diagrams and outlines, shipped as browser-native ESM.",
  "type": "module",
  "author": "wanggang <76527413@qq.com>",
  "license": "MIT",
  "keywords": [
    "markdown",
    "markdown-it",
    "esm",
    "importmap",
    "katex",
    "mermaid",
    "prismjs",
    "vitepress"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbaxp/mdi2esm.git"
  },
  "homepage": "https://github.com/nbaxp/mdi2esm#readme",
  "bugs": {
    "url": "https://github.com/nbaxp/mdi2esm/issues"
  },
  "module": "./dist/index.min.js",
  "main": "./dist/index.min.js",
  "exports": {
    ".": {
      "development": "./dist/index.js",
      "default": "./dist/index.min.js"
    },
    "./index": "./dist/index.js",
    "./index.min": "./dist/index.min.js",
    "./index.css": "./dist/index.css",
    "./index.min.css": "./dist/index.min.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js",
    "dist/index.min.js",
    "dist/index.css",
    "dist/index.min.css",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "preview": "vite preview --host localhost",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --max-warnings 0 --fix",
    "prepublishOnly": "npm run build && npm test && npm run lint"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mdit-vue/plugin-toc": "4.0.0",
    "@mdit-vue/shared": "4.0.0",
    "@mdit/plugin-anchor": "2.4.0",
    "@mdit/plugin-attrs": "1.5.0",
    "@mdit/plugin-container": "2.2.0",
    "@mdit/plugin-emoji": "1.3.0",
    "@mdit/plugin-footnote": "1.2.0",
    "@mdit/plugin-tasklist": "1.3.0",
    "markdown-it": "15.0.3",
    "markdown-it-cjk-friendly": "3.0.0",
    "prismjs": "1.30.0"
  },
  "peerDependencies": {
    "katex": "0.19.1",
    "medium-zoom": "1.1.2",
    "mermaid": "12.3.0",
    "vue": "^3.5.44",
    "vue-style-runtime": "^0.5.1"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@eslint/markdown": "^8.0.3",
    "@html-eslint/eslint-plugin": "^0.68.0",
    "@html-eslint/parser": "^0.68.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "katex": "0.19.1",
    "lightningcss": "1.33.0",
    "medium-zoom": "1.1.2",
    "mermaid": "12.3.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vue": "^3.5.44",
    "vue-style-runtime": "^0.5.1"
  }
}
